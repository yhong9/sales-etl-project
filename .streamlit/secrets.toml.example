# Copy these keys into Streamlit Community Cloud's Advanced settings > Secrets.
# Never commit the real .streamlit/secrets.toml file.
POSTGRES_USER = "your_neon_user"
POSTGRES_PASSWORD = "your_neon_password"
POSTGRES_HOST = "your-neon-host.neon.tech"
POSTGRES_PORT = "5432"
POSTGRES_DB = "neondb"
POSTGRES_SSLMODE = "require"
